# Vametrix Cockpit — environment variables
# Copy this to .env.local and fill in. Do NOT commit .env.local.

# Supabase (engine database)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never expose

# Optional: Meta WhatsApp + Marketing (server actions)
META_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_AD_ACCOUNT_ID=
